# Copy to backend/.env for local development.
SIGEC_ENVIRONMENT=development
SIGEC_DEBUG=true
SIGEC_DATABASE_URL=postgresql+psycopg://sigec:sigec@localhost:5432/sigec
SIGEC_REDIS_URL=redis://localhost:6379/0
SIGEC_OIDC_ISSUER=http://localhost:8080/realms/sigec
SIGEC_S3_ENDPOINT_URL=http://localhost:8333
# Active data-model profile (ADR-004). 'alt-synthetic' runs the suite against a
# deliberately different schema, which is how the abstraction is verified.
SIGEC_PROFILE=cnel-gye
